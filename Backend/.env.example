# Copy to .env and adjust as needed. Not committed (see .gitignore).

# SQLite database file used by PersistenceService. Defaults to
# Backend/codetwin.sqlite3 when unset.
# CODETWIN_DATABASE_PATH=./codetwin.sqlite3

# AI provider used by AIAnalysisService for the "ai_analysis" section of an
# experiment result. Defaults to "mock" (deterministic, offline, no API key
# required). Set to "bob" to select the prepared-but-not-yet-connected IBM
# Bob provider (see docs/ai-integration.md) — without BOB_API_ENDPOINT and
# BOB_API_KEY it will report an honest "not_configured" status rather than
# fail the experiment. To integrate a different real LLM provider, implement
# app.ai.providers.base.BaseAIProvider, register it in
# app/services/ai_analysis_service.py, and set its credentials below — API
# keys must only ever live here, never in the frontend.
AI_PROVIDER=mock

# IBM Bob in-app provider credentials (only used when AI_PROVIDER=bob).
# Not currently connected to a real endpoint — see docs/ai-integration.md.
# BOB_API_ENDPOINT=
# BOB_API_KEY=
